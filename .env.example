# Copy this file to `.env` and fill in your values.
# NEVER commit the real `.env` (it is git-ignored).

# --- Copernicus Data Space Ecosystem (CDSE) credentials -------------------
# Create a free account at https://dataspace.copernicus.eu and register an
# OAuth2 client to get a client id/secret:
#   1. Sign in -> click your avatar -> "My account" -> "OAuth2 clients"
#      (or https://identity.dataspace.copernicus.com/auth/realms/CDSE/account)
#   2. Create a new client with grant type "client_credentials".
# Token endpoint: https://identity.dataspace.copernicus.com/auth/realms/CDSE/protocol/openid-connect/token
# STAC catalogue: https://catalogue.dataspace.copernicus.eu/stac
# openEO endpoint: https://openeo.dataspace.copernicus.eu
CDSE_CLIENT_ID=your-client-id
CDSE_CLIENT_SECRET=your-client-secret

# --- App behaviour ----------------------------------------------------------
# Set to "mock" to run the whole pipeline on synthetic rasters without any
# CDSE credentials (used for UI development):  APP_MODE=mock
# Set to "live" to pull real Sentinel-1/2 + GLO-30 data from CDSE.
APP_MODE=mock

# Where everything lives (defaults shown; override if you move the app to
# the headless mini-PC and mount the data disk elsewhere).
# DATA_DIR=data
# DATABASE_URL=sqlite:///data/app.db
